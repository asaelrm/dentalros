# Puerto local y del servidor dentro del contenedor.
PORT=3000
# Cookies seguras para HTTPS de Cloudflare y localhost en navegadores actuales.
COOKIE_SECURE=true
BACKUP_RETENTION=30
BACKUP_INTERVAL_HOURS=24

# URL real del servidor (actualízala al cambiar la URL de Cloudflare Tunnel).
PUBLIC_URL=
# Credenciales SMTP privadas. Nunca se incluyen en Git ni en la imagen.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
